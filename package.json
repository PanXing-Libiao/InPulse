{
  "name": "inpulse",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "contract:generate": "pnpm --filter @inpulse/api-contract generate",
    "contract:drift": "pnpm --filter @inpulse/api-contract drift",
    "contract:validate": "pnpm --filter @inpulse/api-contract validate",
    "check:secrets": "node scripts/check_secrets.mjs",
    "deps:audit": "pnpm audit --audit-level=high",
    "check:deps": "node scripts/check_dependencies.mjs",
    "check:docs": "node scripts/check_docs.mjs",
    "check:frontend:boundaries": "pnpm --filter @inpulse/web check:boundaries",
    "check:deploy": "node scripts/check_deploy_refs.mjs --env deploy/.env.deploy",
    "check:deploy:test": "node scripts/check_deploy_refs.mjs --env deploy/.env.deploy.test",
    "check:deploy:static": "node scripts/check_deploy_refs.mjs --static --env deploy/.env.deploy.test",
    "db:migrate": "pnpm --filter @inpulse/database migrate",
    "db:migrations:check": "pnpm --filter @inpulse/database migrations:check",
    "db:seed:demo": "node apps/api/scripts/seed-demo-data.mjs",
    "db:seed:check": "node scripts/export-demo-seed.mjs --check database/seed/demo-data.sql",
    "db:poc:search": "pnpm --filter @inpulse/database poc:search",
    "db:poc:search:local": "powershell -NoProfile -ExecutionPolicy Bypass -File database/scripts/poc-search-local.ps1",
    "db:poc:search:pgroonga": "pnpm --filter @inpulse/database poc:search:pgroonga",
    "db:poc:search:pgroonga:local": "powershell -NoProfile -ExecutionPolicy Bypass -File database/scripts/poc-search-pgroonga-local.ps1",
    "db:test": "pnpm --filter @inpulse/database test",
    "db:test:local": "powershell -NoProfile -ExecutionPolicy Bypass -File database/scripts/test-local.ps1",
    "permissions:check": "pnpm --filter @inpulse/api-contract exec tsx scripts/permissions.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:integration:local": "node scripts/test-integration-local.mjs",
    "test:web": "pnpm --filter @inpulse/web test",
    "test:e2e": "pnpm --filter @inpulse/e2e test:e2e",
    "test:e2e:local": "node scripts/test-e2e-local.mjs",
    "test:search:db": "pnpm --filter @inpulse/api test:search:db",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm db:migrations:check && pnpm db:seed:check && pnpm contract:drift && pnpm contract:validate && pnpm build && pnpm check:deploy:static && pnpm check:deps && pnpm check:frontend:boundaries && pnpm permissions:check && pnpm deps:audit && pnpm check:secrets && pnpm check:docs"
  },
  "devDependencies": {
    "@inpulse/eslint-config": "workspace:*",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "catalog:"
  }
}
