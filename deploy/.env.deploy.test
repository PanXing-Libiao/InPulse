# 仅供 CI / 本地结构预检使用的合成镜像 ref；仓库和 digest 均为虚构值，
# 不得用于发布，也不代表任何受信镜像已构建。
DB_IMAGE_REF=inpulse/postgres:18.6-preflight@sha256:1111111111111111111111111111111111111111111111111111111111111111
MIGRATE_IMAGE_REF=inpulse/migrate:0.0.0-preflight@sha256:2222222222222222222222222222222222222222222222222222222222222222
API_IMAGE_REF=inpulse/api:0.0.0-preflight@sha256:3333333333333333333333333333333333333333333333333333333333333333
WEB_IMAGE_REF=inpulse/web:0.0.0-preflight@sha256:4444444444444444444444444444444444444444444444444444444444444444
OPS_IMAGE_REF=inpulse/ops:0.0.0-preflight@sha256:5555555555555555555555555555555555555555555555555555555555555555
BACKUP_GIT_SHA=5555555555555555555555555555555555555555
SESSION_HASH_KEY_VERSION=
IDEMPOTENCY_FINGERPRINT_KEY_VERSION=
AUDIT_HMAC_KEY_VERSION=
# ADR-032 单点登录（结构预检用非敏感取值，不代表任何真实环境）。
SSO_ENABLED=0
SSO_ISSUER=https://authtest.libiaorobot.com
SSO_CLIENT_ID=inpulse-preflight
SSO_REDIRECT_URI=https://inpulse.example.com/api/v1/auth/sso/callback
CASDOOR_IMPORT_ORGANIZATION=libiaorobot.com
SESSION_IDLE_MAX_AGE_SECONDS=7200
# ADR-067 AI 辅助转换：结构预检默认关闭。
AI_ASSIST_ENABLED=0
