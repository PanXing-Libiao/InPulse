# 部署环境变量示例（不含任何 Secret 值；仅镜像 ref 与 key 版本号）。
# 真实发布前必须用受信镜像仓库解析后的 tag@sha256:digest 替换下列 REPLACE_ME 值，
# 并通过 `pnpm check:deploy --env deploy/.env.deploy` 校验。
DB_IMAGE_REF=REPLACE_ME_WITH_POSTGRES_18_6_DIGEST
MIGRATE_IMAGE_REF=REPLACE_ME_WITH_MIGRATE_IMAGE_DIGEST
API_IMAGE_REF=REPLACE_ME_WITH_API_IMAGE_DIGEST
WEB_IMAGE_REF=REPLACE_ME_WITH_WEB_IMAGE_DIGEST
OPS_IMAGE_REF=REPLACE_ME_WITH_OPS_IMAGE_DIGEST
# 备份签名清单注入：40 位小写 Git commit SHA（生产模式 backup 容器缺少该值即 fail closed）。
BACKUP_GIT_SHA=REPLACE_ME_WITH_40_HEX_GIT_SHA
SESSION_HASH_KEY_VERSION=
IDEMPOTENCY_FINGERPRINT_KEY_VERSION=
AUDIT_HMAC_KEY_VERSION=
# ADR-032 单点登录：部署默认启用；SSO_ENABLED 非 1/true 时整体关闭并回落本地隐藏入口。
# 上线前必须把 SSO_ISSUER / SSO_CLIENT_ID / SSO_REDIRECT_URI 换成正式取值，把 Casdoor 签发的
# Client Secret 写入 deploy/secrets/sso_client_secret（compose 挂载为 /run/secrets/sso_client_secret），
# 并在 Casdoor 应用中登记 SSO_REDIRECT_URI；禁止任何环境变量或明文兜底。
SSO_ENABLED=1
SSO_ISSUER=https://auth.libiaorobot.com
SSO_CLIENT_ID=REPLACE_ME_WITH_CASDOOR_APPLICATION_CLIENT_ID
SSO_REDIRECT_URI=https://REPLACE_ME_WITH_PUBLIC_HOST/api/v1/auth/sso/callback
# ADR-100 管理员批量导入所属 Casdoor organization；留空时导入接口 503，不影响 SSO 登录。
# 同一 application 凭据还须可读取 /api/get-users 与 /api/get-groups。
CASDOOR_IMPORT_ORGANIZATION=libiaorobot.com
SESSION_IDLE_MAX_AGE_SECONDS=7200
# ADR-067 文档导入 AI 辅助转换（默认关闭；AI_ASSIST_ENABLED 非 1/true 即整体关闭，
# 关闭时 API 对 assist 路由统一返回 503 AI_ASSIST_DISABLED）。
# 启用步骤：
#   1. 把中转站（OpenAI 兼容）密钥写入 deploy/secrets/ai_assist_api_key（仅部署账户可读；
#      禁用时可放空占位文件，Compose 要求文件存在）；
#   2. 设置 AI_ASSIST_ENABLED=1、AI_ASSIST_ENDPOINT（完整 chat/completions 地址，必须 https）、
#      AI_ASSIST_MODEL；
#   3. 重新创建 api 容器（docker compose up -d --force-recreate api）。
# 密钥只从 /run/secrets/ai_assist_api_key 读取，禁止任何环境变量或明文兜底；
# 超时与输出上限可选：留空即用 compose 默认值（60000 ms / 8192 tokens）。
# 注意 AI_ASSIST_MAX_TOKENS 的名字含 TOKEN，会被 check:secrets 视为敏感键，
# 示例文件里必须留空（不得放示例值）。
AI_ASSIST_ENABLED=0
AI_ASSIST_ENDPOINT=
AI_ASSIST_MODEL=
AI_ASSIST_TIMEOUT_MS=
AI_ASSIST_MAX_TOKENS=
# ADR-068 管理员在线配置的主密钥（AES-256-GCM 信封加密）：把一行
# 1:<64 位十六进制> 写入 deploy/secrets/ai_assist_encryption_key（compose 挂载为
# /run/secrets/ai_assist_encryption_key）。未使用在线配置时可放空占位文件
#（Compose 要求文件存在）；轮换主密钥时用下面的版本号指向 keyring 当前版本。
# 该键名含 KEY，会被 check:secrets 视为敏感键，示例文件里必须留空。
AI_ASSIST_ENCRYPTION_KEY_VERSION=
# ADR-070 企业微信机器人 Secret 信封加密主密钥版本；键名含 KEY，示例必须留空。
WECOM_ROBOT_ENCRYPTION_KEY_VERSION=
